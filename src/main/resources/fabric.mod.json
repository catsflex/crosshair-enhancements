{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"version": "${mod_version}",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"homepage": "${mod_homepage_url}",
		"sources": "${mod_sources_url}",
		"issues": "${mod_issues_url}"
	},
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"me.catsflex.${mod_package_id}.Main"
		],
		"modmenu": [
			"me.catsflex.${mod_package_id}.config.gui.ModMenuIntegration"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"minecraft": ">=${minecraft_version}",
		"fabricloader": ">=${fabric_loader_version}",
		"fabric-api": ">=${fabric_api_version}"
	},
	"suggests": {
		"modmenu": ">=${modmenu_version}",
		"yet_another_config_lib": ">=${yacl_version}"
	}
}
